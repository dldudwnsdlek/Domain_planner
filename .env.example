# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 커밋하지 않습니다.
KOPIS_API_KEY=
KAKAO_REST_API_KEY=
# 공공데이터포털 기상청 단기예보 — Decoding 키
KMA_SERVICE_KEY=
# SSAFY GMS에서 받은 LLM 키
GMS_KEY=
# GMS 접속 주소 — 비어 있으면 LLM을 호출하지 않음 (Claude: .../gmsapi/api.anthropic.com/v1)
LLM_BASE_URL=
LLM_MODEL=claude-haiku-5-5
MAX_REPLAN=
DETAIL_FETCH_LIMIT=
EXIT_BUFFER_MIN=
DB_PATH=
# 심화 F3021 구성: A(단일 Agent) / B(Planner·Worker, Worker LLM 끔) / C(Worker LLM 켬, 기본값)
AGENT_MODE=
